# General/Common Configuration
GEMFURY_URL=
ENVIRONMENT=local
ACCOUNT_ID=
AWS_REGION=eu-west-2
APP_NAME=atlas-beststartinlife
REPO=10ds-atlas-beststartinlife
VERSION=v1

# S3 CONFIGURATION (used by the Dagster data pipeline)
FILESYSTEM=s3
DATA_PATH=bsil/v1
DATA_BUCKET=ten-ds-clean-data
SOURCE_BUCKET=ten-ds-raw-data
TARGET_BUCKET=ten-ds-clean-data

# LOCAL CONFIGURATION (uncomment these lines and comment out S3 lines above to run locally)
# FILESYSTEM=local
# DATA_PATH=bsil
# DATA_BUCKET=./data/v1
# SOURCE_BUCKET=./data
# TARGET_BUCKET=./data/clean

# NOTE: SOURCE_BUCKET above is used only by the Dagster pipeline (data/load-sources etc.).
# Makefile targets data/push-exported and data/fetch-exported use a separate dedicated bucket
# (beststartinlife-<env>-source-data) to store exported_data/app/ as intermediary build data
# for image builds. This is derived from the `env` variable — not SOURCE_BUCKET.

# Dashboard
PORT=8080

# Postgres
POSTGRES_USER=bsil
POSTGRES_PASSWORD=
POSTGRES_DB=bsil
DAGSTER_PG_DB=dagster

# Prisma
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/bsil?schema=published

# Export
# Set to "true" to include pipeline metadata (_metadata) in app export JSON
EXPORT_INCLUDE_METADATA=true

# Ordinance Survey
ORDINANCE_SURVEY_API_KEY=

# Vite feature flags (set to "true" to enable in dev)
VITE_FEATURE_SORT_DAILY=true
VITE_FEATURE_SORT_ANNUAL=true
VITE_FEATURE_NO_BIG_KID_ESTIMATES=true
VITE_FEATURE_NO_PROVIDER_ESTIMATES=true
VITE_FEATURE_NO_ADDITIONAL_CHARGES=true

# Posthog - used for pulling events data
POSTHOG_PROJECT_ID=123456
POSTHOG_API_KEY=phx_your-api-key
