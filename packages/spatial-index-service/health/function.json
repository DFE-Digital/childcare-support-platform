{
    "$schema": "https://json.schemastore.org/function.json",
    "entryPoint": "handler",
    "bindings": [
        {
            "type": "httpTrigger",
            "direction": "in",
            "name": "request",
            "authLevel": "anonymous",
            "methods": ["get"],
            "route": "/health"
        },
        {
            "type": "http",
            "direction": "out",
            "name": "response"
        }
    ]
}